{
  "name": "fantasy-workspace",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/write-build-info.mjs --development && ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "node scripts/write-build-info.mjs && NG_BUILD_CACHE_STORE=sqlite ng build",
    "watch": "node scripts/write-build-info.mjs --development && ng build --watch --configuration development",
    "test": "node scripts/write-build-info.mjs --if-missing && ng test",
    "test:build-info": "node --test scripts/write-build-info.spec.mjs"
  },
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
